import java.util.Locale;
import java.util.Scanner;

public class exercicio_06 {

	public static void main(String[] args) {
		Locale.setDefault(Locale.US);
		Scanner sc = new Scanner(System.in);
		
		double entrada;
	
		entrada = sc.nextDouble();
		
		if (entrada > 0 && entrada < 100) {
			if(entrada <= 25.0) {
				System.out.printf("O INTERVALO ESTA ENTRE 0 A 25");
			}
			else if(entrada >= 25.0 && entrada <= 50.0) {
				System.out.printf("O INTERVALO ESTA ENTRE 25 A 50");
			} 
			else if(entrada > 50 && entrada < 75) {
				System.out.printf("O INTERVALO ESTA ENTRE 50 A 75");
			}
			else if(entrada > 75 && entrada < 100) {
				System.out.printf("O INTERVALO ESTA ENTRE 75 A 100");
			}
			}
		else {
			
			System.out.println("FORA DE INTERVALO");
		}
		sc.close();
	
		
}
}

