package entities;

public class Triangle {
	// ATRIBUTOS
	public double a;
	public double b;
	public double c;

	//abaixo é um metodo, ela é publica, double pq ela vai retornar um numero double
	public double area() {
		double p = (a + b + c) / 2.0;	
		return Math.sqrt(p * (p - a) * (p - b) * (p - c));
	}
}
